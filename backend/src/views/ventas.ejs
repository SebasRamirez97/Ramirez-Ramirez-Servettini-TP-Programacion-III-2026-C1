<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tenkiu - Registro de Ventas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">

    <header class="bg-dark text-white p-3 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <img src="/logo.png" alt="Logo" style="width: 40px; height: 40px;">
                <h1 class="h4 m-0">Tenkiu - Finanzas</h1>
            </div>
            <nav class="d-flex gap-3">
                <a href="/api/administradores/dashboard" class="btn btn-outline-light btn-sm">Dashboard</a>
                <a href="/api/administradores/ventas" class="btn btn-outline-light btn-sm active">Ver Ventas</a>
            </nav>
        </div>
    </header>

    <main class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Historial de Ventas Exitosas</h2>
            <a href="/api/administradores/dashboard" class="btn btn-secondary">← Volver al Dashboard</a>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nro Factura</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Productos Comprados (Detalle Relación)</th>
                            <th>Total Abonado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ventas.length === 0) { %>
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No se registran ventas en el sistema todavía.</td>
                            </tr>
                        <% } else { %>
                            <% ventas.forEach(function(v) { %>
                                <tr>
                                    <td>#<%= String(v.id).padStart(6, '0') %></td>
                                    <td><%= new Date(v.createdAt).toLocaleDateString('es-AR') %></td>
                                    <td><%= v.nombre_cliente || 'Cliente Anónimo' %></td>
                                    <td>
                                        <ul class="mb-0 small">
                                            <% if (v.Productos && v.Productos.length > 0) { %>
                                                <% v.Productos.forEach(function(p) { %>
                                                    <li>
                                                        <%= p.nombre %> x<%= p.VentaProductos ? p.VentaProductos.cantidad : 1 %>
                                                    </li>
                                                <% }); %>
                                            <% } else { %>
                                                <span class="text-muted text-italic">Sin detalle</span>
                                            <% } %>
                                        </ul>
                                    </td>
                                    <td class="fw-bold text-success">$<%= v.precio_total.toLocaleString('es-AR') %></td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white-50 text-center py-3 mt-auto">
        <div class="container">
            <p class="m-0 small">UTN Avellaneda - Programación III</p>
            <p class="m-0 small"><strong>Alumnos:</strong> Ramirez - Ramirez - Servettini</p>
        </div>
    </footer>
    <script src="/script.js"></script>
</body>
</html>