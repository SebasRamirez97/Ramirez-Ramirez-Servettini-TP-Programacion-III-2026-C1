<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tenkiu - Registro de Ventas</title>

    <link rel="icon" href="/logo.png" type="image/png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/admin-styles.css">
</head>
<body>
    <script>
        if (localStorage.getItem('tema') === 'oscuro') {
            document.body.classList.add('dark-mode');
        }
        </script>

    <header>
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <img src="/logo.png" alt="Logo" style="width: 40px; height: 40px;">
                <h1 class="m-0 fuente-marca gap-2">Tenkiu - Finanzas</h1>
            </div>
            <nav class="d-flex gap-3">
                <button id="btn-tema" type="button" class="btn btn-dark" style="font-size: 1.2rem; padding: 6px 12px;">
                    🌙
                </button>
                <a href="/api/administradores/login" class="btn btn-danger w-100 text-center">Cerrar Sesión</a>
            </nav>
        </div>
    </header>

    <main class="container my-5">
        <div class="d-grid align-items-center mb-4 gap-3" style="grid-template-columns: 3fr 1.5fr 1.5fr;">
            <h2>Historial de Ventas Exitosas</h2>
            <button id="btn-exportar-excel" class="btn btn-success">📊 Descargar Excel Ventas</button>
            <a href="/api/administradores/dashboard" class="btn btn-secondary">← Volver al Dashboard</a>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive tabla-scroll-contenedor">
                <table id="tabla-ventas" class="table table-striped table-dark-custom align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nro Factura</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Productos Comprados (Detalle Relación)</th>
                            <th>Total Abonado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ventas.length === 0) { %>
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No se registran ventas en el sistema todavía.</td>
                            </tr>
                        <% } else { %>
                            <% ventas.forEach(function(v) { %>
                                <tr>
                                    <td>#<%= String(v.id).padStart(6, '0') %></td>
                                    <td><%= new Date(v.createdAt).toLocaleDateString('es-AR') %></td>
                                    <td><%= v.nombre_cliente || 'Cliente Anónimo' %></td>
                                    <td>
                                        <ul class="mb-0 small">
                                            <% if (v.Productos && v.Productos.length > 0) { %>
                                                <% v.Productos.forEach(function(p) { %>
                                                    <li>
                                                        <%= p.nombre %> x<%= p.VentaProductos ? p.VentaProductos.cantidad : 1 %>
                                                    </li>
                                                <% }); %>
                                            <% } else { %>
                                                <span class="text-muted text-italic">Sin detalle</span>
                                            <% } %>
                                        </ul>
                                    </td>
                                    <td class="fw-bold text-success">$<%= v.precio_total.toLocaleString('es-AR') %></td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white-50 text-center py-3 mt-auto">
        <div class="container">
            <p class="m-0 small">UTN Avellaneda - Programación III</p>
            <p class="m-0 small"><strong>Alumnos:</strong> Ramirez - Ramirez - Servettini</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="/admin-script.js"></script>
</body>
</html>